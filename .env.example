# 复制成 .env（docker compose 会自动读取）。

# ---- 镜像与容器 ----

QM_TAG=0.1.0

# 容器用户；./data 必须归这个 UID 所有
QM_UID=1000
QM_GID=1000

# 网页监听：0.0.0.0 允许局域网访问；只想本机访问改 127.0.0.1
QM_PUBLISH=0.0.0.0
QM_PORT=8790

TZ=Asia/Shanghai
QM_LOG=quantumark=info

# ---- 首次启动的管理员密码 ----
# 留空：程序会在日志里打印一次性设置码，首次打开网页时用设置码设置密码
# 填写：直接用这个密码（至少 8 位），之后可在网页里改
QM_ADMIN_PASSWORD=

# ---- 宿主机路径的挂载范围 ----
# 宿主机这个目录会以只读方式挂到容器的 /host，任务里的路径在网页里浏览选择。
# 想缩小范围就改成具体的数据根，例如 QM_HOST_ROOT=/vol1
QM_HOST_ROOT=/
# 可写目录：只有要开“上传后删除本地”时才需要，指向宿主机上的“待上传”目录。
# 多设备 SMB 中转时指向专用投递目录（见 README「多设备推送」），例如：
# QM_UPLOAD_DIR=/srv/smb/quantumark-inbox

# ---- 构建参数（镜像被墙时改成镜像站） ----
# BUILDER_BASE=docker.m.daocloud.io/library/rust:1-bookworm
# RUNTIME_BASE=docker.m.daocloud.io/library/debian:bookworm-slim
BUILDER_BASE=rust:1-bookworm
RUNTIME_BASE=debian:bookworm-slim
CARGO_BUILD_JOBS=4
CARGO_REGISTRY_MIRROR=sparse+https://rsproxy.cn/index/
